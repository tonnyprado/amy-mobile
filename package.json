{
  "name": "amy-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "expo": "^58.0.0",
    "expo-av": "^16.0.8",
    "expo-battery": "~58.0.4",
    "expo-camera": "~58.0.14",
    "expo-dev-client": "~58.0.20",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^1.16.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-signature-canvas": "^5.0.2",
    "react-native-svg": "15.16.0",
    "react-native-tts": "^4.1.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-worklets-core": "^1.6.3"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.24.0",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "dotenv": "^18.0.10",
    "jest": "~30.5.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/config/**/*.js",
      "src/services/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 40,
        "branches": 30,
        "functions": 40,
        "lines": 40
      }
    }
  }
}
