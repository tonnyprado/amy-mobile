# Configuración de Variables de Entorno
# Copia este archivo a .env y configura tus valores

# Entorno de la app (development, staging, production)
APP_ENV=development

# URL del backend API
# Desarrollo: http://192.168.0.14:8080 (cambia la IP a tu servidor local)
# Staging: https://amy-backend-staging.onrender.com
# Producción: https://amy-backend-minutaapi.onrender.com
API_BASE_URL=http://192.168.0.14:8080

# Google Maps API Key
# Obtén tu API key en: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui
